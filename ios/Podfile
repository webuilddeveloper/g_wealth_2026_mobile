platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Xcode 15+/26: BoringSSL-GRPC ใช้ flag ที่ทำให้ compile พัง
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        ## dart: PermissionGroup.camera (ปิด — แอปไม่ใช้กล้อง)
        'PERMISSION_CAMERA=0',
        ## dart: PermissionGroup.microphone
        'PERMISSION_MICROPHONE=0',
        ## dart: PermissionGroup.photos
        'PERMISSION_PHOTOS=1',
        ## dart: PermissionGroup.location
        'PERMISSION_LOCATION=1',
        ## dart: PermissionGroup.bluetooth
        'PERMISSION_BLUETOOTH=0',
      ]

      # Xcode 16+/26: ปิด Explicit Modules กัน PCM / header lookup พังตอน Archive
      config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'

      # gRPC: ให้ #include "src/core/..." หาไฟล์เจอ
      if ['gRPC-Core', 'gRPC-C++'].include?(target.name)
        config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/gRPC-Core"'
        config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/gRPC-C++"'
        config.build_settings['USER_HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['USER_HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/gRPC-Core"'
        config.build_settings['USER_HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/gRPC-C++"'
        config.build_settings['USE_HEADERMAP'] = 'NO'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end
end
